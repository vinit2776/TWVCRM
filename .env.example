# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TWV CRM

# Gmail API (for inbound email pipeline)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_WATCH_EMAIL=cases@theworkvilla.com
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications

# Anthropic Claude API (for email parsing)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional — model used by the aggregator email parser. Defaults to claude-sonnet-4-20250514 if unset.
ANTHROPIC_EMAIL_PARSER_MODEL=claude-sonnet-4-20250514

# Digio e-Sign API
DIGIO_CLIENT_ID=your-digio-client-id
DIGIO_CLIENT_SECRET=your-digio-client-secret
DIGIO_API_BASE_URL=https://api.digio.in
DIGIO_ENVIRONMENT=sandbox

# Vercel API (for live usage data on Infrastructure page)
VERCEL_API_TOKEN=your-vercel-personal-access-token
VERCEL_TEAM_ID=team_xxxx   # optional — only needed for team/org accounts

# Leegality e-Sign API
LEEGALITY_API_KEY=your-leegality-auth-token
LEEGALITY_PRIVATE_SALT=your-leegality-private-salt
# Correct API base URL — endpoints are /sign/request
LEEGALITY_API_URL=https://api.leegality.com/v3.0
LEEGALITY_ENVIRONMENT=production
# Workflow Profile ID — from Leegality Dashboard > Settings > Workflows
LEEGALITY_PROFILE_ID=your-leegality-workflow-profile-id
# Server-side canonical URL — used to build the Leegality webhook callback URL
APP_URL=https://your-production-domain.com
