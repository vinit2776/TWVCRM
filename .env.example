# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TWV CRM

# Gmail API (for inbound email pipeline)
# Not currently configured in any environment — the pipeline has never run.
# See docs/gmail-intake.md before setting these.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_WATCH_EMAIL=cases@theworkvilla.com
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications
# Authenticates the Pub/Sub push to /api/email/inbound. Both are REQUIRED —
# the endpoint rejects every request until they are set, because an open
# webhook lets anyone poison the history checkpoint and skip all future mail.
GMAIL_PUBSUB_AUDIENCE=https://twv-crm.vercel.app/api/email/inbound
GMAIL_PUBSUB_SA_EMAIL=gmail-push@your-project.iam.gserviceaccount.com

# Anthropic Claude API (for email parsing, and the in-app WorkVilla Assistant help chat)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional — model used by the aggregator email parser. Defaults to claude-sonnet-4-20250514 if unset.
ANTHROPIC_EMAIL_PARSER_MODEL=claude-sonnet-4-20250514
# Optional — model used by the /api/help-chat assistant. Defaults to claude-haiku-4-5-20251001 if unset.
ANTHROPIC_HELP_CHAT_MODEL=claude-haiku-4-5-20251001

# Digio e-Sign API
DIGIO_CLIENT_ID=your-digio-client-id
DIGIO_CLIENT_SECRET=your-digio-client-secret
DIGIO_API_BASE_URL=https://api.digio.in
DIGIO_ENVIRONMENT=sandbox

# Vercel API (for live usage data on Infrastructure page)
VERCEL_API_TOKEN=your-vercel-personal-access-token
VERCEL_TEAM_ID=team_xxxx   # optional — only needed for team/org accounts

# Leegality e-Sign API
LEEGALITY_API_KEY=your-leegality-auth-token
LEEGALITY_PRIVATE_SALT=your-leegality-private-salt
# Correct API base URL — endpoints are /sign/request
LEEGALITY_API_URL=https://api.leegality.com/v3.0
LEEGALITY_ENVIRONMENT=production
# Workflow Profile ID — from Leegality Dashboard > Settings > Workflows
LEEGALITY_PROFILE_ID=your-leegality-workflow-profile-id
# Server-side canonical URL — used to build the Leegality webhook callback URL
APP_URL=https://your-production-domain.com

# Ruijie Cloud API (WiFi voucher issuance — Nungambakkam Arcade)
RUIJIE_APP_ID=your-ruijie-app-id
RUIJIE_APP_SECRET=your-ruijie-app-secret
# Optional — defaults to https://cloud-as.ruijienetworks.com
RUIJIE_CLOUD_URL_PREFIX=https://cloud-as.ruijienetworks.com

# Attendance Gateway satellite app (separate Vercel project, separate login).
# The /attendance-gateway launch page shows an "unconfigured" state until this is set.
NEXT_PUBLIC_ATTENDANCE_URL=https://attendance.theworkvilla.com

# Encrypts IT asset admin passwords (facility_asset_credentials.password_encrypted)
# at rest. Must be a 64-character hex string (32 bytes) -- generate with:
#   openssl rand -hex 32
# Losing/rotating this key makes every previously-stored password undecryptable,
# so back it up somewhere safe outside of git (e.g. the team password manager).
ASSET_CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# ── Public enquiry forms on enquire.theworkvilla.com (all optional; unset = feature off) ──
# Google Tag Manager container for /enquire, /meta, /walkin only (GA4, Google Ads and the
# Meta Pixel are configured inside GTM). Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Cloudflare Turnstile bot check on the public forms. Fails open if Cloudflare is down.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Each form on its own host so existing short links keep working (Production scope only,
# and only once the DNS records are live). Format: host=/path,host=/path
PUBLIC_FORM_HOSTS=enquire.theworkvilla.com=/enquire,meta.theworkvilla.com=/meta,walkin.theworkvilla.com=/walkin
# Old CRM host whose /enquire /meta /walkin paths should redirect to the hosts above.
LEGACY_PUBLIC_FORMS_HOST=twv-crm.vercel.app
