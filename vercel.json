{
  "crons": [
    {
      "path": "/api/petty-cash/day-book",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/digest",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/billing/auto-generate",
      "schedule": "30 15 28-31 * *"
    },
    {
      "path": "/api/cron/db-backup",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/storage-backup",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/headcount-reminder",
      "schedule": "30 4 * * 1-6"
    },
    {
      "path": "/api/cron/headcount-reminder",
      "schedule": "30 8 * * 1-6"
    },
    {
      "path": "/api/cron/headcount-reminder",
      "schedule": "30 12 * * 1-6"
    },
    {
      "path": "/api/cron/kyc-reminder",
      "schedule": "0 4 * * 6"
    },
    {
      "path": "/api/cron/contract-expiry",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/renewal-reminders",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
