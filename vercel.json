{
  "crons": [
    {
      "path": "/api/petty-cash/day-book",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/digest",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
