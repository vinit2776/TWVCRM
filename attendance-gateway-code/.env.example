# Attendance Gateway — environment variables.
# Copy to .env for local development. In production these are set in the
# Vercel project settings, never committed.

# --- Database (required) ---
# Turso / libSQL. The schema is created automatically on first boot.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# --- First-run accounts (see init() in server.js) ---
# Local development only: seeds EMP-001..5 / "password123" and admin / "admin123".
# These are publicly-known credentials — never set this on a deployment that is
# reachable from the internet.
SEED_DEMO_DATA=true
# Production bootstrap instead: creates a single "admin" account with this password
# the first time the users table is found empty, and forces a change at first login.
# Remove the variable once you have logged in and rotated it.
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Device / punch authentication (required in production) ---
# Shared secret for POST /api/punch. Without it a random key is generated per
# process, which changes on every cold start and no device can authenticate.
PUNCH_API_KEY=
# The ZKTeco K40 Pro's serial number. The /iclock/* ADMS endpoints have no other
# authentication — unset, they accept pushes from any device on the internet.
ZK_DEVICE_SN=

# --- Scheduled jobs (required in production) ---
# Protects /internal/auto-checkout, which Vercel Cron calls at 19:00 IST with an
# "Authorization: Bearer <CRON_SECRET>" header.
CRON_SECRET=

# --- Office network detection ---
# Comma-separated public IPs of the office. The self-service WiFi punch button is
# hidden entirely until this is set. Assumes a static IP — recheck if the ISP
# hands out a dynamic one.
OFFICE_WIFI_IPS=
# Display-only hint shown under the punch button; has no effect on verification.
OFFICE_WIFI_SSID=Workvilla_LGF

# --- LocationIQ (field trips + on-site reverse geocoding) ---
LOCATIONIQ_API_KEY=
# LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
# Bias address suggestions to one country and bounding box (lon1,lat1,lon2,lat2).
# Defaults below are India / Chennai.
# PLACES_COUNTRY=in
# PLACES_VIEWBOX=79.95,12.75,80.35,13.35

# --- Local standalone mode only ---
# PORT=3001
# APP_TZ=Asia/Kolkata
