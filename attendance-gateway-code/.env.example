# Attendance Gateway — environment variables.
# Copy to .env for local development. In production these are set in the Vercel
# project settings, never committed.
#
# Most operational configuration now lives in the app instead, at /admin/settings
# (admin only) — office IPs, device serial, API keys and so on. A value set there
# overrides the environment variable of the same name and takes effect within
# ~30 seconds, with no redeploy. The variables below are only the ones that must
# exist before that page can be reached, plus optional deploy-time defaults.

# === Required ===============================================================

# Turso / libSQL. Needed in order to read every other setting, so this one can
# never move into the admin UI. The schema is created automatically on first boot.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Protects /internal/auto-checkout, which Vercel Cron calls at 19:00 IST with an
# "Authorization: Bearer <CRON_SECRET>" header. Environment-only on purpose: it
# guards a route with no logged-in admin to fix a misconfiguration.
CRON_SECRET=

# === First-run accounts =====================================================

# Creates a single "admin" account with this password the first time the users
# table is found empty, and forces a change at first login. Remove it once you
# have logged in and rotated. Environment-only by necessity — it runs before any
# admin account exists.
# ADMIN_BOOTSTRAP_PASSWORD=

# Local development only: seeds EMP-001..5 / "password123" and admin / "admin123".
# Publicly-known credentials — never set this on a deployment reachable from the
# internet.
SEED_DEMO_DATA=true

# === Optional deploy-time defaults ==========================================
# All of these are editable at /admin/settings, which is the better place for
# them. Setting one here only provides the value a fresh database starts with.

# Comma-separated office public IPs. The self-service WiFi punch button stays
# hidden until this is set, either here or in the UI.
# OFFICE_WIFI_IPS=
# OFFICE_WIFI_SSID=Workvilla_LGF

# The ZKTeco K40 Pro's serial number. The /iclock/* ADMS endpoints reject every
# push while this is empty — which is the correct state until the device exists.
# ZK_DEVICE_SN=

# Shared secret for POST /api/punch. While empty, a random key is generated per
# process and changes on every cold start, so no device can authenticate. Prefer
# the "Generate a new key" button at /admin/settings.
# PUNCH_API_KEY=

# Minutes subtracted from every device-reported timestamp; see /admin/settings.
# DEVICE_CLOCK_OFFSET_MINUTES=150

# LocationIQ powers field trips and on-site reverse geocoding. The Field Trips tab
# is hidden while this is empty; nothing else depends on it.
# LOCATIONIQ_API_KEY=
# LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
# PLACES_COUNTRY=in
# PLACES_VIEWBOX=79.95,12.75,80.35,13.35

# Comma-separated, in the order they should appear on the Branch dropdown in
# Employee Registration and Edit Employee.
# BRANCHES=Branch 1,Branch 2,Branch 3

# === Local standalone mode only =============================================
# PORT=3001
# APP_TZ=Asia/Kolkata
