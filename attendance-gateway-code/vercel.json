{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "regions": ["bom1"],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/internal/auto-checkout", "schedule": "30 13 * * *" },
    { "path": "/internal/auto-checkout", "schedule": "30 15 * * *" },
    { "path": "/internal/auto-checkout", "schedule": "15 18 * * *" },
    { "path": "/internal/daily-report/morning", "schedule": "30 4 * * *" },
    { "path": "/internal/daily-report/evening", "schedule": "30 13 * * *" }
  ]
}
