# =============================================================================
# TWV CRM Backup Configuration
# Copy this to .backup.env and fill in your values
# NEVER commit .backup.env to git
# =============================================================================

# Backblaze B2 credentials (from App Keys page)
B2_KEY_ID=your-key-id-here
B2_APPLICATION_KEY=your-application-key-here

# Supabase PostgreSQL (from Project Settings → Database → Connection string URI)
SUPABASE_DB_HOST=db.zlbvadtajetylacxevsm.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=your-db-password-here

# Supabase Storage S3-compatible access
# Found at: Project Settings → Storage → S3 Access
SUPABASE_STORAGE_KEY_ID=your-storage-access-key-id
SUPABASE_STORAGE_SECRET=your-storage-secret-access-key
SUPABASE_STORAGE_ENDPOINT=https://zlbvadtajetylacxevsm.supabase.co/storage/v1/s3
